{
  "name": "x420",
  "version": "0.1.0",
  "private": true,
  "description": "X420 — AI medical-cannabis companion for Solana Seeker + x402 payment gateway at x420.org",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
